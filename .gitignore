# datasets & derived data (large / regenerable, never committed)
/data/**
!/data/**/.gitkeep

# run outputs: checkpoints, logs, metrics, exported models
/runs/**
!/runs/**/.gitkeep
*.pth
*.ckpt
*.onnx
*.tflite

# reports keep their .md (committed) but not large attached artifacts
/reports/**/*.png
/reports/**/*.onnx

# local paths override (contains machine-specific absolute paths)
configs/paths.local.yaml

# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
build/
dist/

# os / editor
.DS_Store
.vscode/
.idea/

# third_party clones (cloned fresh, not vendored)
/third_party/**
!/third_party/.gitkeep

# downloaded archives (regenerable)
/data/_dl_*/
/runs_devon

# demo notebook intermediates (regenerable via scripts/build_demo_data.py)
/runs/demo_nb/real/*.npy
/runs/int8_demo/*.npy
/runs/int8_demo/*.onnx
/runs/demo_nb/*.onnx

# RESIDE manifests (regenerable via scripts/reside_manifest.py plan)
/reports/reside_required_*.txt
/runs/demo_nb/nb_figs/

# local/experiment scratch (untracked on purpose)
/logs/
/mlruns/
/reports/checksums/
/weights_stable/

# teacher response/feature cache (58 GB, regenerable via
# scripts/build_teacher_cache.py -- never committed)
/cache/**

# reports keep their .md, not large attached media (same rule as .png above)
/reports/**/*.mp4
